        <mxCell id="r2c2" parent="1" vertex="1" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;Фиксирует ставку по обращению. АБС запускает СМС." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eef4f8;strokeColor=#ffffff;fontFamily=Arial;fontSize=16;fontColor=#233c50;fontStyle=0;align=left;verticalAlign=middle;spacing=10;">
